# Optional Copernicus CDS credentials for source acquisition only.
# The analysis and publication build do not require secrets after the
# coordinate-free release bundle has been unpacked.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=replace_with_your_personal_key

# NASA Earthdata downloads use earthaccess.login() or a local .netrc file.
# Never commit an Earthdata password, token, CDS key, or service-account JSON.
